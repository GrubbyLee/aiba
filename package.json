{
  "name": "aiba-workspace",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "smoke": "node scripts/smoke.mjs",
    "release:check": "node scripts/release/check-version.mjs",
    "pack:artifacts": "node scripts/release/pack.mjs --out artifacts",
    "pack:check": "pnpm build && node scripts/release/verify-packages.mjs",
    "fixture:core-state": "node scripts/generate-core-fixture-state.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm smoke && pnpm release:check && node scripts/release/verify-packages.mjs",
    "aiba": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
