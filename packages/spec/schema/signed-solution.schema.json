{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/v0alpha1/signed-solution.schema.json",
  "title": "AIBA Signed Solution Envelope",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "solution", "publisher", "signature"],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,95}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "properties": {
    "apiVersion": { "const": "aiba.dev/v0alpha1" }, "kind": { "const": "SignedSolutionEnvelope" },
    "metadata": { "type": "object", "additionalProperties": false, "required": ["sequence", "createdAt", "expiresAt"], "properties": { "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "createdAt": { "type": "string", "format": "date-time" }, "expiresAt": { "type": "string", "format": "date-time" } } },
    "solution": { "type": "object", "additionalProperties": false, "required": ["id", "version", "path", "sha256"], "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/version" }, "path": { "const": "solution.yaml" }, "sha256": { "$ref": "#/$defs/sha" } } },
    "publisher": { "type": "object", "additionalProperties": false, "required": ["id", "keyId"], "properties": { "id": { "$ref": "#/$defs/id" }, "keyId": { "$ref": "#/$defs/id" } } },
    "signature": { "type": "object", "additionalProperties": false, "required": ["algorithm", "keyId", "value"], "properties": { "algorithm": { "const": "Ed25519" }, "keyId": { "$ref": "#/$defs/id" }, "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" } } }
  }
}
