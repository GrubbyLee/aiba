{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/v0alpha1/registry-trust-policy.schema.json",
  "title": "AIBA Capability Registry Trust Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "registries"],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,95}$" }
  },
  "properties": {
    "apiVersion": { "const": "aiba.dev/v0alpha1" },
    "kind": { "const": "CapabilityRegistryTrustPolicy" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": { "id": { "$ref": "#/$defs/identifier" } }
    },
    "registries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["registry", "publisher", "keyId", "algorithm", "publicKey"],
        "properties": {
          "registry": { "$ref": "#/$defs/identifier" },
          "publisher": { "$ref": "#/$defs/identifier" },
          "keyId": { "$ref": "#/$defs/identifier" },
          "algorithm": { "const": "Ed25519" },
          "publicKey": { "type": "string", "minLength": 100, "maxLength": 1000 }
        }
      }
    }
  }
}
