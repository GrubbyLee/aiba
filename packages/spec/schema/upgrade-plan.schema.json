{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/v0alpha1/upgrade-plan.schema.json",
  "title": "AIBA Capability Upgrade Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "capability", "recipe", "migration", "project", "drift", "operations", "evidence"],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,95}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safePath": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
    "evidenceType": { "enum": ["source", "test", "config", "document"] },
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "pathPattern", "description"],
      "properties": {
        "type": { "$ref": "#/$defs/evidenceType" },
        "pathPattern": { "$ref": "#/$defs/safePath" },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "evidencePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant", "requirements", "suggestions", "items"],
      "properties": {
        "invariant": { "$ref": "#/$defs/identifier" },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["acceptedTypes", "requiredTypes", "minimum", "requireHash"],
          "properties": {
            "acceptedTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/evidenceType" } },
            "requiredTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/evidenceType" } },
            "minimum": { "type": "integer", "minimum": 1, "maximum": 20 },
            "requireHash": { "type": "boolean" }
          }
        },
        "suggestions": { "type": "array", "items": { "$ref": "#/$defs/suggestion" } },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "path"],
            "properties": {
              "type": { "$ref": "#/$defs/evidenceType" },
              "path": { "$ref": "#/$defs/safePath" },
              "description": { "type": "string", "minLength": 1, "maxLength": 500 },
              "ownership": { "enum": ["generated", "shared", "project"] },
              "operation": { "$ref": "#/$defs/identifier" }
            }
          }
        }
      }
    },
    "migrationOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "intent", "affectedInvariants", "guidance"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "intent": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "affectedInvariants": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "guidance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
      }
    }
  },
  "properties": {
    "apiVersion": { "const": "aiba.dev/v0alpha1" },
    "kind": { "const": "UpgradePlan" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fromVersion", "toVersion", "fromManifestSha256", "targetManifestSha256"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "fromVersion": { "$ref": "#/$defs/version" },
        "toVersion": { "$ref": "#/$defs/version" },
        "fromManifestSha256": { "$ref": "#/$defs/sha256" },
        "targetManifestSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "toVersion", "targetSha256"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "fromVersion": { "$ref": "#/$defs/version" },
        "toVersion": { "$ref": "#/$defs/version" },
        "targetSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/version" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 120 } }
    },
    "drift": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "installedSha256", "ownership", "evidenceTypes", "invariants", "operations", "status", "conflict"],
        "properties": {
          "path": { "$ref": "#/$defs/safePath" },
          "installedSha256": { "$ref": "#/$defs/sha256" },
          "ownership": { "enum": ["generated", "shared", "project"] },
          "evidenceTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/evidenceType" } },
          "invariants": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
          "operations": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
          "status": { "enum": ["unchanged", "customized", "missing"] },
          "actualSha256": { "$ref": "#/$defs/sha256" },
          "conflict": { "enum": ["none", "customized-generated", "customized-shared", "missing-generated", "missing-shared"] },
          "resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "rationale"],
            "properties": {
              "action": { "enum": ["adapt", "preserve", "replace", "remove"] },
              "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        }
      }
    },
    "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/migrationOperation" } },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidencePlan" } }
  }
}
