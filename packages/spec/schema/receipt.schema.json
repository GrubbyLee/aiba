{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/v0alpha1/receipt.schema.json",
  "title": "AIBA Capability Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "capability", "installation", "invariants"],
  "properties": {
    "apiVersion": { "const": "aiba.dev/v0alpha1" },
    "kind": { "const": "CapabilityReceipt" },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "createdAt"],
      "dependentRequired": {
        "plan": ["planSha256"],
        "planSha256": ["plan"],
        "ancestry": ["ancestrySha256"],
        "ancestrySha256": ["ancestry"]
      },
      "properties": {
        "method": { "enum": ["manual", "agent", "generator"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "agent": { "type": "string", "minLength": 1, "maxLength": 160 },
        "recipe": { "type": "string", "minLength": 1, "maxLength": 160 },
        "plan": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
        "planSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "ancestry": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
        "ancestrySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "governance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "policy", "policySha256", "approvals"],
          "properties": {
            "operation": { "enum": ["install", "upgrade"] },
            "policy": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
            "policySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "approvals": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "sha256", "approver", "keyId"],
                "properties": {
                  "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
                  "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "approver": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,95}$" },
                  "keyId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,95}$" }
                }
              }
            }
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,95}$" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "path"],
              "properties": {
                "type": { "enum": ["source", "test", "config", "document"] },
                "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "description": { "type": "string", "minLength": 1, "maxLength": 500 },
                "ownership": { "enum": ["generated", "shared", "project"] },
                "operation": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" }
              }
            }
          }
        }
      }
    }
  }
}
