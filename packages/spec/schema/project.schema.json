{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/v0alpha1/project.schema.json",
  "title": "AIBA Project Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "project", "capabilities"],
  "properties": {
    "apiVersion": { "const": "aiba.dev/v0alpha1" },
    "kind": { "const": "Project" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "stack": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "languages": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "frameworks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "receipt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
          "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
          "receipt": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" }
        }
      }
    }
  }
}
