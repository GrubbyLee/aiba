{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/v0alpha1/behavior-runner-trust-policy.schema.json",
  "title": "AIBA Behavioral Test Runner Trust Policy",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "runners"],
  "$defs": { "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,95}$" } },
  "properties": {
    "apiVersion": { "const": "aiba.dev/v0alpha1" }, "kind": { "const": "BehaviorRunnerTrustPolicy" },
    "metadata": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "$ref": "#/$defs/identifier" } } },
    "runners": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["runner", "keyId", "algorithm", "publicKey", "subjects"],
        "properties": {
          "runner": { "$ref": "#/$defs/identifier" }, "keyId": { "$ref": "#/$defs/identifier" }, "algorithm": { "const": "Ed25519" },
          "publicKey": { "type": "string", "minLength": 100, "maxLength": 1000 },
          "subjects": { "type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": { "type": "string", "pattern": "^(\\*|[a-z][a-z0-9-]{1,95})$" } },
          "revokedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
