{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/v0alpha1/migration.schema.json",
  "title": "AIBA Capability Migration",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,95}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" }
  },
  "properties": {
    "apiVersion": { "const": "aiba.dev/v0alpha1" },
    "kind": { "const": "CapabilityMigration" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/version" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "operations"],
      "properties": {
        "capability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "fromVersion", "toVersion"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "fromVersion": { "$ref": "#/$defs/version" },
            "toVersion": { "$ref": "#/$defs/version" }
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "intent", "affectedInvariants", "guidance"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "intent": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "affectedInvariants": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
              "guidance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
            }
          }
        }
      }
    }
  }
}
