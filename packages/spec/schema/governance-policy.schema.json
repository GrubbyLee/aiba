{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/v0alpha1/governance-policy.schema.json",
  "title": "AIBA Team Governance Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,95}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" }
  },
  "properties": {
    "apiVersion": { "const": "aiba.dev/v0alpha1" },
    "kind": { "const": "TeamGovernancePolicy" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities", "approvers", "requirements", "approvalTtlSeconds", "prohibitSelfApproval"],
      "properties": {
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "versions"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
              "versions": { "type": "string", "minLength": 1, "maxLength": 160 }
            }
          }
        },
        "approvers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "keyId", "algorithm", "publicKey", "permissions"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "keyId": { "$ref": "#/$defs/identifier" },
              "algorithm": { "const": "Ed25519" },
              "publicKey": { "type": "string", "minLength": 100, "maxLength": 1000 },
              "permissions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["install", "upgrade"] }
              }
            }
          }
        },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["install", "upgrade", "upgradeWithConflicts"],
          "properties": {
            "install": { "type": "integer", "minimum": 1, "maximum": 20 },
            "upgrade": { "type": "integer", "minimum": 1, "maximum": 20 },
            "upgradeWithConflicts": { "type": "integer", "minimum": 1, "maximum": 20 }
          }
        },
        "approvalTtlSeconds": { "type": "integer", "minimum": 60, "maximum": 2592000 },
        "prohibitSelfApproval": { "type": "boolean" }
      }
    }
  }
}
