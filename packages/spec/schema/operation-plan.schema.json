{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/v0alpha1/operation-plan.schema.json",
  "title": "AIBA Agent Operation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "capability", "recipe", "project", "writeScope", "operations", "evidence"],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,95}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safePath": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
    "evidenceType": { "enum": ["source", "test", "config", "document"] },
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "pathPattern", "description"],
      "properties": {
        "type": { "$ref": "#/$defs/evidenceType" },
        "pathPattern": { "$ref": "#/$defs/safePath" },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "intent", "requiredInterfaces", "invariants", "guidance"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "intent": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "requiredInterfaces": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" } },
        "invariants": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "guidance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
      }
    }
  },
  "properties": {
    "apiVersion": { "const": "aiba.dev/v0alpha1" },
    "kind": { "const": "OperationPlan" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "manifestSha256"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/version" },
        "manifestSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/version" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "stack"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "stack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["languages", "frameworks"],
          "properties": {
            "languages": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "frameworks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "writeScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedPatterns"],
      "properties": {
        "allowedPatterns": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/safePath" } }
      }
    },
    "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operation" } },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invariant", "requirements", "suggestions", "items"],
        "properties": {
          "invariant": { "$ref": "#/$defs/identifier" },
          "requirements": {
            "type": "object",
            "additionalProperties": false,
            "required": ["acceptedTypes", "requiredTypes", "minimum", "requireHash"],
            "properties": {
              "acceptedTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/evidenceType" } },
              "requiredTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/evidenceType" } },
              "minimum": { "type": "integer", "minimum": 1, "maximum": 20 },
              "requireHash": { "type": "boolean" }
            }
          },
          "suggestions": { "type": "array", "items": { "$ref": "#/$defs/suggestion" } },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "path"],
              "properties": {
                "type": { "$ref": "#/$defs/evidenceType" },
                "path": { "$ref": "#/$defs/safePath" },
                "description": { "type": "string", "minLength": 1, "maxLength": 500 },
                "ownership": { "enum": ["generated", "shared", "project"] },
                "operation": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" }
              }
            }
          }
        }
      }
    }
  }
}
