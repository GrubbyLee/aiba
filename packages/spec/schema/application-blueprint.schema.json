{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/v0alpha1/application-blueprint.schema.json",
  "title": "AIBA Application Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "versionRange": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[0-9A-Za-z.*+<>=~^| -]+$" },
    "safePath": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f]+$" },
    "fieldId": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]{0,62}$" },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "required", "sensitive"],
      "properties": {
        "id": { "$ref": "#/$defs/fieldId" },
        "type": { "enum": ["string", "text", "integer", "number", "boolean", "date", "datetime", "enum", "asset", "tags", "reference"] },
        "required": { "type": "boolean" },
        "sensitive": { "type": "boolean" },
        "unique": { "type": "boolean" },
        "dictionary": { "$ref": "#/$defs/id" },
        "targetResource": { "$ref": "#/$defs/id" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "targetResource", "kind", "onDelete"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "targetResource": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["one-to-one", "one-to-many", "many-to-many"] },
        "onDelete": { "enum": ["restrict", "detach", "cascade"] }
      }
    },
    "stateMachine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial", "states", "transitions"],
      "properties": {
        "initial": { "$ref": "#/$defs/id" },
        "states": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "terminal"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "terminal": { "type": "boolean" }
            }
          }
        },
        "transitions": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "from", "to", "operation"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "from": { "$ref": "#/$defs/id" },
              "to": { "$ref": "#/$defs/id" },
              "operation": { "$ref": "#/$defs/id" }
            }
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "fields", "relationships"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "fields": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/field" } },
        "relationships": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/relationship" } },
        "stateMachine": { "$ref": "#/$defs/stateMachine" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "resource", "kind", "authorization", "inputFields", "outputFields", "idempotent", "emits"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "resource": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["create", "read", "update", "delete", "list", "transition", "custom"] },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action"],
          "properties": { "action": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$", "maxLength": 160 } }
        },
        "inputFields": { "type": "array", "uniqueItems": true, "maxItems": 200, "items": { "$ref": "#/$defs/fieldId" } },
        "outputFields": { "type": "array", "uniqueItems": true, "maxItems": 200, "items": { "$ref": "#/$defs/fieldId" } },
        "idempotent": { "type": "boolean" },
        "emits": { "type": "array", "uniqueItems": true, "maxItems": 50, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "payloadFields", "triggers"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "operation": { "$ref": "#/$defs/id" },
        "payloadFields": { "type": "array", "uniqueItems": true, "maxItems": 100, "items": { "$ref": "#/$defs/fieldId" } },
        "triggers": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "action", "delivery"],
            "properties": {
              "capability": { "$ref": "#/$defs/id" },
              "action": { "$ref": "#/$defs/id" },
              "delivery": { "enum": ["synchronous", "asynchronous"] }
            }
          }
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "fields", "operations", "features"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["list", "detail", "form", "dashboard"] },
        "resource": { "$ref": "#/$defs/id" },
        "fields": { "type": "array", "uniqueItems": true, "maxItems": 200, "items": { "$ref": "#/$defs/fieldId" } },
        "operations": { "type": "array", "uniqueItems": true, "maxItems": 100, "items": { "$ref": "#/$defs/id" } },
        "features": { "type": "array", "uniqueItems": true, "maxItems": 20, "items": { "enum": ["search", "filters", "pagination", "bulk-actions", "tags"] } }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "severity", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "severity": { "enum": ["info", "warning", "error", "critical"] },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredTypes", "minimum", "pathPatterns"],
          "properties": {
            "requiredTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["source", "test", "config", "document"] } },
            "minimum": { "type": "integer", "minimum": 1, "maximum": 20 },
            "pathPatterns": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "$ref": "#/$defs/safePath" } }
          }
        }
      }
    }
  },
  "properties": {
    "apiVersion": { "const": "aiba.dev/v0alpha1" },
    "kind": { "const": "ApplicationBlueprint" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "resources", "operations", "events", "ui", "acceptance", "adaptation"],
      "properties": {
        "requirements": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "version", "reason"],
            "properties": {
              "capability": { "$ref": "#/$defs/id" },
              "version": { "$ref": "#/$defs/versionRange" },
              "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        },
        "resources": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/resource" } },
        "operations": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/operation" } },
        "events": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/event" } },
        "ui": {
          "type": "object",
          "additionalProperties": false,
          "required": ["surfaces"],
          "properties": { "surfaces": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/surface" } } }
        },
        "acceptance": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/acceptance" } },
        "adaptation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["writeScopes"],
          "properties": { "writeScopes": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "$ref": "#/$defs/safePath" } } }
        }
      }
    }
  }
}
