{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/v0alpha1/ancestry.schema.json",
  "title": "AIBA Capability Ancestry",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "capability", "recipe", "createdAt", "files"],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,95}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safePath": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" }
  },
  "properties": {
    "apiVersion": { "const": "aiba.dev/v0alpha1" },
    "kind": { "const": "CapabilityAncestry" },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "installedSha256", "ownership", "evidenceTypes", "invariants", "operations"],
        "properties": {
          "path": { "$ref": "#/$defs/safePath" },
          "installedSha256": { "$ref": "#/$defs/sha256" },
          "ownership": { "enum": ["generated", "shared", "project"] },
          "evidenceTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["source", "test", "config", "document"] }
          },
          "invariants": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          },
          "operations": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          }
        }
      }
    }
  }
}
