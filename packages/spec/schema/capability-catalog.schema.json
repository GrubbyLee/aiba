{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/v0alpha1/capability-catalog.schema.json",
  "title": "AIBA Capability Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "capabilities"],
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "layer": {
      "enum": [
        "application-foundation",
        "platform-integration",
        "business-capability",
        "engineering-governance",
        "industry-solution"
      ]
    }
  },
  "properties": {
    "apiVersion": { "const": "aiba.dev/v0alpha1" },
    "kind": { "const": "CapabilityCatalog" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "layer"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
          "version": { "$ref": "#/$defs/version" },
          "layer": { "$ref": "#/$defs/layer" }
        }
      }
    }
  }
}
