{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/v0alpha1/application-blueprint-upgrade-plan.schema.json",
  "title": "AIBA Application Blueprint Upgrade Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "changes", "preservedCustomizations", "requiredResolutions"],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,95}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safePath": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f]+$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256", "planSha256"],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "planSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "customization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "ownership", "note", "evidencePaths"],
      "properties": {
        "taskId": { "$ref": "#/$defs/id" },
        "ownership": { "const": "project" },
        "note": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidencePaths": { "type": "array", "uniqueItems": true, "maxItems": 100, "items": { "$ref": "#/$defs/safePath" } }
      }
    }
  },
  "properties": {
    "apiVersion": { "const": "aiba.dev/v0alpha1" },
    "kind": { "const": "ApplicationBlueprintUpgradePlan" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "blueprintId", "from", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "blueprintId": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/source" },
        "to": { "$ref": "#/$defs/source" }
      }
    },
    "changes": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "targetType", "target", "summary", "requiresResolution"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "category": { "enum": ["additive", "breaking", "security-sensitive", "conflict"] },
          "targetType": { "enum": ["capability", "resource", "field", "relationship", "state-machine", "operation", "event", "ui", "acceptance", "adaptation", "customization"] },
          "target": { "type": "string", "minLength": 1, "maxLength": 200 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "requiresResolution": { "type": "boolean" }
        }
      }
    },
    "preservedCustomizations": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/customization" } },
    "requiredResolutions": { "type": "array", "uniqueItems": true, "maxItems": 1000, "items": { "$ref": "#/$defs/id" } }
  }
}
