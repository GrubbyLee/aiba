{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/v0alpha1/trust-policy.schema.json",
  "title": "AIBA Publisher Trust Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "publishers"],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,95}$" }
  },
  "properties": {
    "apiVersion": { "const": "aiba.dev/v0alpha1" },
    "kind": { "const": "PublisherTrustPolicy" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" }
      }
    },
    "publishers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["publisher", "keyId", "algorithm", "publicKey", "capabilities"],
        "properties": {
          "publisher": { "$ref": "#/$defs/identifier" },
          "keyId": { "$ref": "#/$defs/identifier" },
          "algorithm": { "const": "Ed25519" },
          "publicKey": { "type": "string", "minLength": 100, "maxLength": 1000 },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          }
        }
      }
    }
  }
}
