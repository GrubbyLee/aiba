{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/v0alpha1/solution-trust-policy.schema.json",
  "title": "AIBA Solution Publisher Trust Policy",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "publishers"],
  "$defs": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,95}$" } },
  "properties": {
    "apiVersion": { "const": "aiba.dev/v0alpha1" }, "kind": { "const": "SolutionPublisherTrustPolicy" },
    "metadata": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "$ref": "#/$defs/id" } } },
    "publishers": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "type": "object", "additionalProperties": false, "required": ["publisher", "keyId", "algorithm", "publicKey", "solutions"], "properties": { "publisher": { "$ref": "#/$defs/id" }, "keyId": { "$ref": "#/$defs/id" }, "algorithm": { "const": "Ed25519" }, "publicKey": { "type": "string", "minLength": 100, "maxLength": 1000 }, "solutions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(\\*|[a-z][a-z0-9-]{1,95})$" } }, "revokedAt": { "type": "string", "format": "date-time" } } } }
  }
}
