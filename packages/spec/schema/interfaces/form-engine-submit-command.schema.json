{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/form-engine-submit-command.schema.json",
  "title": "AIBA Form Engine Submit Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["formCode", "expectedRevision", "data", "idempotencyKey"],
  "properties": {
    "formCode": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,62}$" },
    "expectedRevision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "data": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": { "$ref": "#/$defs/value" }
    },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128 }
  },
  "$defs": {
    "scalar": { "type": ["string", "number", "boolean", "null"] },
    "value": {
      "oneOf": [
        { "$ref": "#/$defs/scalar" },
        { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/scalar" } }
      ]
    }
  }
}
