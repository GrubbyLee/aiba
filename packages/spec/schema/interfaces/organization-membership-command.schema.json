{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/organization-membership-command.schema.json",
  "title": "AIBA Organization Membership Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "userId", "idempotencyKey"],
  "properties": {
    "action": { "enum": ["add", "change-role", "remove"] },
    "userId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "roleId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
    "expectedRevision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 200, "pattern": "^[A-Za-z0-9._:-]+$" }
  },
  "allOf": [
    { "if": { "properties": { "action": { "enum": ["add", "change-role"] } } }, "then": { "properties": { "roleId": {} }, "required": ["roleId"] } },
    { "if": { "properties": { "action": { "const": "remove" } } }, "then": { "not": { "properties": { "roleId": {} }, "required": ["roleId"] } } }
  ]
}
