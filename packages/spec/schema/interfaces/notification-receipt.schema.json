{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/notification-receipt.schema.json",
  "title": "AIBA Notification Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["notificationId", "status", "channel", "templateId", "templateVersion", "attempt", "createdAt", "updatedAt"],
  "properties": {
    "notificationId": { "type": "string", "minLength": 16, "maxLength": 255 },
    "status": { "enum": ["queued", "delivering", "sent", "suppressed", "failed"] },
    "channel": { "enum": ["in-app", "email", "sms", "wechat-template"] },
    "templateId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,95}$" },
    "templateVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "attempt": { "type": "integer", "minimum": 0, "maximum": 20 },
    "errorCode": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
