{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/resource-page.schema.json",
  "title": "AIBA Resource Page",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "hasMore"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": { "type": "object" }
    },
    "hasMore": { "type": "boolean" },
    "nextCursor": {
      "type": "string",
      "minLength": 16,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "total": { "type": "integer", "minimum": 0 }
  },
  "oneOf": [
    {
      "properties": {
        "hasMore": { "const": true },
        "nextCursor": true
      },
      "required": ["hasMore", "nextCursor"]
    },
    {
      "properties": { "hasMore": { "const": false } },
      "required": ["hasMore"],
      "not": { "required": ["nextCursor"] }
    }
  ]
}
