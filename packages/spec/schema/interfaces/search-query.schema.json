{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/search-query.schema.json",
  "title": "AIBA Search Query",
  "type": "object",
  "additionalProperties": false,
  "required": ["term", "resourceTypes", "pageSize"],
  "properties": {
    "term": { "type": "string", "minLength": 1, "maxLength": 200 },
    "resourceTypes": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" } },
    "pageSize": { "type": "integer", "minimum": 1, "maximum": 50 },
    "cursor": { "type": "string", "minLength": 16, "maxLength": 1024, "pattern": "^[A-Za-z0-9._-]+$" }
  }
}
