{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/approval-request-command.schema.json",
  "title": "AIBA Approval Request Command",
  "type": "object", "additionalProperties": false,
  "required": ["definitionId", "resourceType", "resourceId", "idempotencyKey"],
  "properties": {
    "definitionId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
    "resourceType": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
    "resourceId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 200, "pattern": "^[A-Za-z0-9._:-]+$" }
  }
}
