{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/form-engine-schema-result.schema.json",
  "title": "AIBA Form Engine Schema Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["formCode", "revision", "title", "fields", "loadedAt"],
  "properties": {
    "formCode": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,62}$" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 2000 },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/field" }
    },
    "loadedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "optionValue": { "type": ["string", "number", "boolean"] },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "$ref": "#/$defs/optionValue" },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "disabled": { "type": "boolean" }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "equals"],
      "properties": {
        "field": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$" },
        "equals": { "type": ["string", "number", "boolean", "null"] }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "label"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$" },
        "type": { "enum": ["string", "number", "boolean", "date", "select", "multiselect", "textarea", "file"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "placeholder": { "type": "string", "maxLength": 200 },
        "required": { "type": "boolean" },
        "readonly": { "type": "boolean" },
        "minLength": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "pattern": { "type": "string", "minLength": 1, "maxLength": 200 },
        "maximumSelections": { "type": "integer", "minimum": 1, "maximum": 200 },
        "options": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/option" } },
        "dependsOn": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$" }
        },
        "visibleWhen": { "$ref": "#/$defs/condition" }
      }
    }
  }
}
