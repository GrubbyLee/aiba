{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/data-dict-query-result.schema.json",
  "title": "AIBA Data Dictionary Query Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["dictCode", "revision", "items", "page", "pageSize", "total", "queriedAt"],
  "properties": {
    "dictCode": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,62}$" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "data-dict-item-record.schema.json" }
    },
    "page": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "pageSize": { "type": "integer", "minimum": 1, "maximum": 200 },
    "total": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "queriedAt": { "type": "string", "format": "date-time" }
  }
}
