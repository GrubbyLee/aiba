{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/feature-flag-evaluation-command.schema.json",
  "title": "AIBA Feature Flag Evaluation Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["flagKey"],
  "properties": {
    "flagKey": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,119}$" },
    "expectedRevision": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
  }
}
