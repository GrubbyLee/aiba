{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/webhook-delivery-command.schema.json",
  "title": "AIBA Webhook Delivery Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["subscriptionId", "eventType", "resourceId", "idempotencyKey"],
  "properties": {
    "subscriptionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,160}$" },
    "eventType": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,119}$" },
    "resourceId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 200, "pattern": "^[A-Za-z0-9._:-]+$" }
  }
}
