{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/inbox-transition-command.schema.json",
  "title": "AIBA Inbox Transition Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "targets", "idempotencyKey"],
  "properties": {
    "action": { "enum": ["mark-read", "mark-unread", "archive"] },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["messageId", "expectedRevision"],
        "properties": {
          "messageId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "expectedRevision": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
        }
      }
    },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" }
  }
}
