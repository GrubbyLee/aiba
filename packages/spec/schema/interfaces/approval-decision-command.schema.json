{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/approval-decision-command.schema.json",
  "title": "AIBA Approval Decision Command",
  "type": "object", "additionalProperties": false,
  "required": ["workflowId", "decision", "expectedRevision", "idempotencyKey"],
  "properties": {
    "workflowId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,160}$" },
    "decision": { "enum": ["approve", "reject"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
    "expectedRevision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 200, "pattern": "^[A-Za-z0-9._:-]+$" }
  }
}
