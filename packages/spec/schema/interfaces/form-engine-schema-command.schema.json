{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/form-engine-schema-command.schema.json",
  "title": "AIBA Form Engine Schema Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["formCode"],
  "properties": {
    "formCode": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,62}$" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
  }
}
