{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/file-asset-record.schema.json",
  "title": "AIBA File Asset Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["assetId", "status", "sizeBytes", "contentType", "sha256", "createdAt"],
  "properties": {
    "assetId": { "type": "string", "minLength": 16, "maxLength": 255 },
    "status": { "enum": ["quarantined", "available", "rejected", "deleted"] },
    "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 5368709120 },
    "contentType": { "type": "string", "minLength": 3, "maxLength": 255 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
