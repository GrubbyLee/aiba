{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/tag-assignment-command.schema.json",
  "title": "AIBA Tag Assignment Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "resourceType", "resourceId", "tagIds", "expectedRevision", "idempotencyKey"],
  "properties": {
    "action": { "enum": ["attach", "detach"] },
    "resourceType": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
    "resourceId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "tagIds": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
    "expectedRevision": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" }
  }
}
