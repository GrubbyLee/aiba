{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/organization-membership-record.schema.json",
  "title": "AIBA Organization Membership Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["membershipId", "organizationId", "userId", "roleId", "status", "revision", "createdAt", "updatedAt"],
  "properties": {
    "membershipId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,160}$" },
    "organizationId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "userId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "roleId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
    "status": { "enum": ["active", "removed"] },
    "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
