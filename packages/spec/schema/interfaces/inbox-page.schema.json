{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/inbox-page.schema.json",
  "title": "AIBA Inbox Page",
  "type": "object",
  "additionalProperties": false,
  "required": ["messages", "hasMore", "unreadCount"],
  "properties": {
    "messages": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/message" } },
    "hasMore": { "type": "boolean" },
    "nextCursor": { "type": "string", "minLength": 16, "maxLength": 1024, "pattern": "^[A-Za-z0-9._-]+$" },
    "unreadCount": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
  },
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId", "category", "title", "body", "status", "revision", "createdAt", "updatedAt"],
      "properties": {
        "messageId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "category": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,79}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "body": { "type": "string", "maxLength": 4000 },
        "status": { "enum": ["unread", "read", "archived"] },
        "resourceType": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
        "resourceId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "readAt": { "type": "string", "format": "date-time" },
        "archivedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "oneOf": [
    { "properties": { "hasMore": { "const": true } }, "required": ["nextCursor"] },
    { "properties": { "hasMore": { "const": false } }, "not": { "required": ["nextCursor"] } }
  ]
}
