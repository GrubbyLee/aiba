{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/operation-control.schema.json",
  "title": "AIBA Operation Control",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "expectedRevision": { "type": "integer", "minimum": 1 }
  }
}
