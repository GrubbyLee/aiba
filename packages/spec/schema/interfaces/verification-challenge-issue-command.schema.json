{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/verification-challenge-issue-command.schema.json",
  "title": "AIBA Verification Challenge Issue Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipientId", "channel", "purpose", "idempotencyKey"],
  "properties": {
    "recipientId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "channel": { "enum": ["email", "sms", "authenticator"] },
    "purpose": { "type": "string", "pattern": "^[a-z][a-z0-9:-]{1,79}$" },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 200, "pattern": "^[A-Za-z0-9._:-]+$" }
  }
}
