{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/approval-workflow-record.schema.json",
  "title": "AIBA Approval Workflow Record",
  "type": "object", "additionalProperties": false,
  "required": ["workflowId", "definitionId", "resourceType", "resourceId", "requesterId", "status", "requiredApprovals", "revision", "decisions", "createdAt", "updatedAt"],
  "properties": {
    "workflowId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,160}$" },
    "definitionId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
    "resourceType": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
    "resourceId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "requesterId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "status": { "enum": ["pending", "approved", "rejected"] },
    "requiredApprovals": { "type": "integer", "minimum": 1, "maximum": 20 },
    "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "decisions": { "type": "array", "maxItems": 20, "items": {
      "type": "object", "additionalProperties": false, "required": ["decisionId", "actorId", "decision", "decidedAt"],
      "properties": {
        "decisionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,160}$" },
        "actorId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "decision": { "enum": ["approve", "reject"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "decidedAt": { "type": "string", "format": "date-time" }
      }
    } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
