{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/i18n-translate-result.schema.json",
  "title": "AIBA i18n Translate Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["locale", "catalogRevision", "translations", "resolvedAt"],
  "properties": {
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2}|-[0-9]{3})?(-[a-z0-9]+)*$" },
    "catalogRevision": { "type": "string", "pattern": "^[a-f0-9]{16,64}$" },
    "translations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value", "source"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,119}(:[a-z][a-z0-9.-]{0,119})*$" },
          "value": { "type": "string", "maxLength": 10000 },
          "source": { "enum": ["exact", "fallback-namespace", "fallback-locale", "default"] },
          "pluralForm": { "enum": ["zero", "one", "two", "few", "many", "other"] }
        }
      }
    },
    "resolvedAt": { "type": "string", "format": "date-time" }
  }
}
