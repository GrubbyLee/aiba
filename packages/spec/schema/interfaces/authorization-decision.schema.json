{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/authorization-decision.schema.json",
  "title": "AIBA Authorization Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisionId", "principal", "action", "resource", "allowed", "reasonCode", "policyVersion", "evaluatedAt"],
  "properties": {
    "decisionId": { "type": "string", "minLength": 16, "maxLength": 255 },
    "principal": { "$ref": "principal.schema.json" },
    "action": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)+$", "maxLength": 255 },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 120 },
        "id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "tenantId": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "allowed": { "type": "boolean" },
    "reasonCode": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 120 },
    "policyVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
    "evaluatedAt": { "type": "string", "format": "date-time" }
  }
}
