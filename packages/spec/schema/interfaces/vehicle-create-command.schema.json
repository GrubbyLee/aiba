{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/vehicle-create-command.schema.json",
  "title": "AIBA Vehicle Create Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["fleetNumber", "plateNumber", "make", "model", "year", "idempotencyKey"],
  "properties": {
    "fleetNumber": { "type": "string", "minLength": 1, "maxLength": 64 },
    "plateNumber": { "type": "string", "minLength": 2, "maxLength": 32 },
    "vin": { "type": "string", "pattern": "^[A-HJ-NPR-Z0-9]{17}$" },
    "make": { "type": "string", "minLength": 1, "maxLength": 80 },
    "model": { "type": "string", "minLength": 1, "maxLength": 80 },
    "year": { "type": "integer", "minimum": 1886, "maximum": 3000 },
    "idempotencyKey": { "type": "string", "minLength": 16, "maxLength": 255 }
  }
}
