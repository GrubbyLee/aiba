{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/data-dict-item-record.schema.json",
  "title": "AIBA Data Dictionary Item Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["itemId", "dictCode", "value", "label", "sortOrder", "status", "revision"],
  "properties": {
    "itemId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "dictCode": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,62}$" },
    "parentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "value": { "type": ["string", "number", "boolean"], "maxLength": 255 },
    "valueType": { "enum": ["string", "number", "boolean"] },
    "label": { "type": "string", "minLength": 1, "maxLength": 200 },
    "sortOrder": { "type": "integer", "minimum": -100000, "maximum": 100000 },
    "status": { "enum": ["enabled", "disabled"] },
    "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
