{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/i18n-catalog-command.schema.json",
  "title": "AIBA i18n Catalog Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["locale"],
  "properties": {
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2}|-[0-9]{3})?(-[a-z0-9]+)*$" },
    "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,119}$" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{16,64}$" }
  }
}
