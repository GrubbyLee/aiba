{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/comment-record.schema.json",
  "title": "AIBA Comment Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["commentId", "resourceType", "resourceId", "authorId", "status", "mentionUserIds", "revision", "createdAt", "updatedAt"],
  "properties": {
    "commentId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,160}$" },
    "resourceType": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
    "resourceId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "authorId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "body": { "type": "string", "minLength": 1, "maxLength": 5000 },
    "status": { "enum": ["active", "deleted"] },
    "mentionUserIds": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
    "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
