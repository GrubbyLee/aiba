{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/vehicle-record.schema.json",
  "title": "AIBA Vehicle Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vehicleId", "fleetNumber", "plateNumber", "make", "model", "year",
    "status", "mileageKm", "revision", "createdAt", "updatedAt"
  ],
  "properties": {
    "vehicleId": { "type": "string", "minLength": 16, "maxLength": 255 },
    "fleetNumber": { "type": "string", "minLength": 1, "maxLength": 64 },
    "plateNumber": { "type": "string", "minLength": 2, "maxLength": 32 },
    "vin": { "type": "string", "pattern": "^[A-HJ-NPR-Z0-9]{17}$" },
    "make": { "type": "string", "minLength": 1, "maxLength": 80 },
    "model": { "type": "string", "minLength": 1, "maxLength": 80 },
    "year": { "type": "integer", "minimum": 1886, "maximum": 3000 },
    "status": { "enum": ["active", "inactive", "retired"] },
    "mileageKm": { "type": "integer", "minimum": 0, "maximum": 10000000 },
    "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
