{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/webhook-delivery-record.schema.json",
  "title": "AIBA Webhook Delivery Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["deliveryId", "subscriptionId", "eventType", "status", "attempt", "maximumAttempts", "createdAt"],
  "properties": {
    "deliveryId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,160}$" },
    "subscriptionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,160}$" },
    "eventType": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,119}$" },
    "status": { "enum": ["pending", "delivering", "retrying", "delivered", "failed"] },
    "attempt": { "type": "integer", "minimum": 0, "maximum": 20 },
    "maximumAttempts": { "type": "integer", "minimum": 1, "maximum": 20 },
    "createdAt": { "type": "string", "format": "date-time" },
    "deliveredAt": { "type": "string", "format": "date-time" },
    "errorCode": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" }
  }
}
