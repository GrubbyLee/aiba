{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/interfaces/v0alpha1/vehicle-update-command.schema.json",
  "title": "AIBA Vehicle Update Command",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 3,
  "required": ["vehicleId", "expectedRevision"],
  "properties": {
    "vehicleId": { "type": "string", "minLength": 16, "maxLength": 255 },
    "expectedRevision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "status": { "enum": ["active", "inactive", "retired"] },
    "mileageKm": { "type": "integer", "minimum": 0, "maximum": 10000000 }
  }
}
