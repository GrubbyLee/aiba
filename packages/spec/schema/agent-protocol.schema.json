{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiba.dev/schema/v0alpha1/agent-protocol.schema.json",
  "title": "AIBA Agent Protocol Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "cliVersion", "protocolVersion", "capabilities", "commands", "envelopes"],
  "properties": {
    "apiVersion": { "const": "aiba.dev/v0alpha1" },
    "kind": { "const": "AgentProtocolDescriptor" },
    "cliVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "protocolVersion": { "const": "0.1.0" },
    "capabilities": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["catalog-discovery", "project-inspection", "capability-install", "solution-workflow", "evidence-verification", "behavior-proof", "customization-upgrade", "registry", "governance"] }
    },
    "commands": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "mutatesProject", "resumable", "json"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
          "mutatesProject": { "type": "boolean" }, "resumable": { "type": "boolean" }, "json": { "const": true }
        }
      }
    },
    "envelopes": {
      "type": "object", "additionalProperties": false,
      "required": ["success", "error"],
      "properties": { "success": { "const": "command-specific-json" }, "error": { "const": "AibaErrorEnvelope" } }
    }
  }
}
