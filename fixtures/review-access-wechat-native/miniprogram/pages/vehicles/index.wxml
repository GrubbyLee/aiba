<view class="page-shell">
  <view class="toolbar">
    <view>
      <text class="eyebrow">FLEET OPERATIONS</text>
      <text class="title">车辆档案</text>
    </view>
    <button class="refresh" size="mini" bindtap="loadVehicles" loading="{{status === 'loading'}}">刷新</button>
  </view>

  <view class="message" wx:if="{{status === 'loading'}}">正在读取车辆数据</view>
  <view class="message error" wx:elif="{{status === 'unavailable'}}">车辆数据暂不可用</view>
  <view class="vehicle-list" wx:else>
    <view class="vehicle-row" wx:for="{{vehicles}}" wx:key="vehicleId">
      <view class="identity">
        <text class="fleet-number">{{item.fleetNumber}}</text>
        <text class="model">{{item.make}} {{item.model}}</text>
      </view>
      <view class="details">
        <text>{{item.plateNumber}}</text>
        <text>{{item.mileageKm}} km</text>
        <text class="state state-{{item.status}}">{{item.status}}</text>
      </view>
    </view>
  </view>
</view>
