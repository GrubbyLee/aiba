.page-shell { box-sizing: border-box; min-height: 100vh; padding: 32rpx 28rpx 56rpx; }
.toolbar { align-items: flex-end; display: flex; justify-content: space-between; margin-bottom: 26rpx; }
.eyebrow, .title { display: block; }
.eyebrow { color: #a33b25; font-size: 20rpx; font-weight: 600; }
.title { font-size: 40rpx; font-weight: 650; margin-top: 8rpx; }
.refresh { margin: 0; }
.message { border-top: 1rpx solid #cbd3ce; color: #59645d; padding: 36rpx 4rpx; }
.error { color: #a33b25; }
.vehicle-row { background: #ffffff; border-bottom: 1rpx solid #dce1dd; padding: 28rpx 24rpx; }
.identity { align-items: baseline; display: flex; gap: 18rpx; }
.fleet-number { font-family: monospace; font-size: 29rpx; font-weight: 650; }
.model { color: #59645d; font-size: 24rpx; }
.details { align-items: center; display: grid; font-size: 24rpx; grid-template-columns: 1fr 1fr auto; margin-top: 18rpx; }
.state { border-radius: 4rpx; padding: 4rpx 10rpx; }
.state-active { background: #e7f3eb; color: #28633e; }
.state-inactive { background: #edf0ee; color: #56615a; }
.state-retired { background: #f5e9e5; color: #8a3828; }
